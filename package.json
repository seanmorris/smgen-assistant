{
  "name": "smgen-assistant",
  "version": "0.1.27",
  "description": "Build a private, in-browser AI assistant for an SMGen site.",
  "keywords": [
    "smgen",
    "webllm",
    "documentation",
    "static-site"
  ],
  "license": "Apache-2.0",
  "author": "Sean Morris",
  "homepage": "https://seanmorris.github.io/smgen-assistant/",
  "bugs": "https://github.com/seanmorris/smgen-assistant/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanmorris/smgen-assistant.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "smgen-assistant": "bin/smgen-assistant.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "site": "bash scripts/build-site.sh",
    "dev": "npm run build && bash scripts/run-smgen.sh watch",
    "clean": "node scripts/build.mjs --clean",
    "eval": "node eval/run.mjs",
    "lint": "eslint .",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "npm run build",
    "prepack": "npm run check"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@mlc-ai/web-llm": "0.2.81",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "playwright-core": "1.59.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
